{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=2000 --fetch-retry-maxtimeout=30000",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/public/practice-tick",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/public/ca-poll-gmail",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/public/ca-auto-followup",
      "schedule": "0 4 * * *"
    }
  ],
  "regions": [
    "syd1"
  ]
}
